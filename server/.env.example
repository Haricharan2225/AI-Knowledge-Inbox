# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Relative to server directory or absolute path)
# In production on Render with a persistent disk mounted at /data:
# DATABASE_PATH=/data/knowledge.db
DATABASE_PATH=./data/knowledge.db

# Logging Configuration
LOG_LEVEL=info

# AI API Keys (Optional - defaults to offline high-precision deterministic vector & grounded synthesis engine if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
